# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual production credentials.
# NEVER commit real .env files to GitHub.
# ==============================================================================

# Application Server Port & Environment
PORT=3000
NODE_ENV=production

# Supabase PostgreSQL Connection & Realtime
# Find these in your Supabase Project Settings -> API
# Example: https://your-project-id.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI Integration (Required for /api/ai/analyze)
# Obtain an API key from https://aistudio.google.com/
GEMINI_API_KEY=
