{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/sw.js",
      "destination": "/frontend/sw.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/frontend/manifest.webmanifest"
    },
    {
      "source": "/manifest.json",
      "destination": "/frontend/manifest.webmanifest"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
